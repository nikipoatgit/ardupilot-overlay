<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nikipo.ardupilotoverlay.ui.controllers.ExportController"
      alignment="CENTER"
      spacing="12">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>
    <Label text="Export" styleClass="page-title"/>
    <Label text="Export tools will be available here once a project contains an overlay."/>
    <Button text="Back to Overlay" onAction="#onBackToOverlay"/>
</VBox>
