<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.nikipo.ardupilotoverlay.ui.controllers.TelemetrySelectorController">

    <!-- Main UI -->
    <AnchorPane  fx:id="contentPane">

        <children>

            <VBox alignment="CENTER"
                  spacing="16.0"
                  AnchorPane.topAnchor="0.0"
                  AnchorPane.bottomAnchor="0.0"
                  AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0">

                <Button fx:id="selectTelemetryButton"
                        text="Select Telemetry File"
                        prefWidth="220"
                        prefHeight="45"
                        onAction="#onSelectTelemetry"/>

                <Label fx:id="statusLabel"/>

            </VBox>

        </children>

    </AnchorPane>

    <!-- Loading Overlay -->
    <VBox fx:id="loadingPane"
          alignment="CENTER"
          spacing="15"
          visible="false"
          managed="false"
          mouseTransparent="false"
          style="-fx-background-color: rgba(0,0,0,0.65);">

        <ProgressIndicator prefWidth="60" prefHeight="60"/>

        <Label text="Decoding telemetry..."
               style="-fx-font-size:16px; -fx-text-fill:white;"/>

        <Label text="Please wait."
               style="-fx-text-fill:#cfcfcf;"/>

    </VBox>

</StackPane>