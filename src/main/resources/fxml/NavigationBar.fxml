<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.nikipo.ardupilotoverlay.ui.navigation.NavigationBarController"
      alignment="CENTER_LEFT"
      spacing="10"
      prefHeight="50"
      styleClass="navigation-bar">

    <padding>
        <Insets top="8" right="10" bottom="8" left="10"/>
    </padding>

    <Button fx:id="homeButton" text="Home" onAction="#onHome"/>
    <Label text=">>" styleClass="breadcrumb-separator"/>
    <Button fx:id="videoButton" text="Video" onAction="#onVideo"/>
    <Label text=">>" styleClass="breadcrumb-separator"/>
    <Button fx:id="projectButton" text="Project" onAction="#onProject"/>
    <Label text=">>" styleClass="breadcrumb-separator"/>
    <Button fx:id="telemetryButton" text="Telemetry" onAction="#onTelemetry"/>
    <Label text=">>" styleClass="breadcrumb-separator"/>
    <Button fx:id="overlayButton" text="Overlay" onAction="#onOverlay"/>
    <Label text=">>" styleClass="breadcrumb-separator"/>
    <Button fx:id="exportButton" text="Export" onAction="#onExport"/>

</HBox>