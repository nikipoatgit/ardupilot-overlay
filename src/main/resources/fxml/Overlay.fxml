<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nikipo.ardupilotoverlay.ui.controllers.OverlayController"
      alignment="CENTER"
      spacing="16">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Overlay Editor"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label text="Overlay editor is under development."
           style="-fx-font-size: 16px;"/>

    <Label text="Ready for testing."
           style="-fx-text-fill: gray;"/>

    <Button text="Continue"
            onAction="#onContinue"/>

</VBox>